---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

const posts = await getCollection('posts')
---

<BaseLayout>
<h1>Lista de todos los posts</h1>
<ul>
    {posts.map(post=><li>
          <a href={'/blog/'+post.id}>{post.data.titulo}</a>
        </li>)}
</ul>
</BaseLayout>